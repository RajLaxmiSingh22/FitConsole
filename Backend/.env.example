# Backend server
PORT=9000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Authentication
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Required bootstrap accounts
OWNER_NAME=REPLACE_WITH_OWNER_NAME
OWNER_EMAIL=REPLACE_WITH_OWNER_EMAIL
OWNER_PASSWORD=REPLACE_WITH_OWNER_PASSWORD_AT_LEAST_12_CHARACTERS

TRAINER_1_NAME=REPLACE_WITH_TRAINER_1_NAME
TRAINER_1_EMAIL=REPLACE_WITH_TRAINER_1_EMAIL
TRAINER_1_PASSWORD=REPLACE_WITH_TRAINER_1_PASSWORD_AT_LEAST_12_CHARACTERS
TRAINER_2_NAME=REPLACE_WITH_TRAINER_2_NAME
TRAINER_2_EMAIL=REPLACE_WITH_TRAINER_2_EMAIL
TRAINER_2_PASSWORD=REPLACE_WITH_TRAINER_2_PASSWORD_AT_LEAST_12_CHARACTERS
TRAINER_3_NAME=REPLACE_WITH_TRAINER_3_NAME
TRAINER_3_EMAIL=REPLACE_WITH_TRAINER_3_EMAIL
TRAINER_3_PASSWORD=REPLACE_WITH_TRAINER_3_PASSWORD_AT_LEAST_12_CHARACTERS

# Optional: diet-plan generation
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Waiver: replace the placeholder with approved, non-empty text before release
WAIVER_VERSION=1
WAIVER_TEXT=REPLACE_WITH_APPROVED_WAIVER_TEXT

# Optional: online payments (configure credentials to enable Cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_RETURN_URL=http://localhost:5173/
