# Backend server
PORT=9000
CORS_ORIGIN=http://localhost:5173
TRIAL_BOOKING_DUPLICATE_WINDOW_HOURS=24
# Set to the exact number of trusted reverse-proxy hops in the deployment.
TRUST_PROXY_HOPS=0
GYM_TIMEZONE=Asia/Kolkata

# PostgreSQL
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Authentication
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_PUBLIC_URL=http://localhost:5173

# Email (SMTP). Used for welcome, sign-in alert, password reset/changed and membership-ending emails.
# For Gmail use smtp.gmail.com, port 465, and a Google "App password" (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="FitConsole <REPLACE_WITH_SENDER_EMAIL>"

# Required owner bootstrap account. Its password is used only when creating the owner for the first time.
OWNER_NAME=REPLACE_WITH_OWNER_NAME
OWNER_EMAIL=REPLACE_WITH_OWNER_EMAIL
OWNER_PASSWORD=REPLACE_WITH_OWNER_PASSWORD_AT_LEAST_12_CHARACTERS

# Optional trainer bootstrap accounts. Omit a slot or configure all three values for that slot.
TRAINER_1_NAME=
TRAINER_1_EMAIL=
TRAINER_1_PASSWORD=
TRAINER_2_NAME=
TRAINER_2_EMAIL=
TRAINER_2_PASSWORD=
TRAINER_3_NAME=
TRAINER_3_EMAIL=
TRAINER_3_PASSWORD=

# Optional: diet-plan generation. Both values are required to enable it; there is no default model.
# Use a model your key can access, e.g. gemini-2.5-flash. Prompts contain no names or contact details.
# Model for AI diet plans, e.g. gemini-3.8-flash. Optional fallback is tried when the main model is busy.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_API_KEY=

# Optional: Cloudinary media storage for profile photos and the owner-managed gallery.
# Without it, profile photos stay in Postgres and gallery uploads are disabled.
# Files go under <root>/users/avatars/<role>/<userId>/ and <root>/gallery/{images,videos}/.
# Either CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud> or the three values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=fitconsole

# Waiver: replace the placeholder with approved, non-empty text before release
WAIVER_VERSION=1
WAIVER_TEXT=REPLACE_WITH_APPROVED_WAIVER_TEXT

# Optional: online payments (configure credentials to enable Cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_RETURN_URL=http://localhost:5173/

# Set to true on exactly one instance to run the 00:05 daily maintenance job.
RUN_JOBS=false

# Session cookies are Secure in production. Set COOKIE_SECURE=false only for plain-HTTP local development.
# The frontend and API must share a registrable domain (e.g. app.example.com + api.example.com) for SameSite=Strict cookies.
COOKIE_SECURE=

# GST rate (percent) used to split GST-inclusive payments in gst.xlsx. Defaults to 18.
GST_RATE=18

# One-click public demo client (login page "Explore Live Demo"). Credentials stay on the server only.
# After setting these, run `npm run seed:demo`. Set DEMO_MODE_ENABLED=false to turn the demo off.
DEMO_MODE_ENABLED=false
DEMO_CLIENT_EMAIL=demo.client@fitconsole.example.com
DEMO_CLIENT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Shared sign-in password for the seeded demo gym coaches and members (@demo.fitconsole.example.com).
# Run `npm run seed:demo-gym` after setting it.
DEMO_GYM_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
